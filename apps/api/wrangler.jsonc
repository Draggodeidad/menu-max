// Worker privado (ADR-002): solo se llama por Service Binding desde apps/web.
// Nunca agregues `routes`, dominio propio ni `workers_dev: true` en ningún entorno.
// Los `database_id` de staging y production son de ejemplo: los reales los pone un humano.
// Las colas `menusmax-jobs*` y sus DLQ las crea un humano en cada entorno antes de publicar.
// Los `namespace_id` de `ratelimits` son provisionales: un humano confirma que sean únicos en la
// cuenta. Los límites (10, 60 y 300 por minuto) son provisionales (ADR-010).
// `RESEND_API_KEY` (ADR-020) y `TURNSTILE_SECRET_KEY` (ADR-010) son secretos: van en `.dev.vars`
// y en los secretos de cada entorno, nunca en `vars`.
// Los buckets R2 `menusmax-media*` (binding `MEDIA`, T17) los crea un humano en clase Standard, con
// dominio propio y caché (nunca r2.dev en producción) y lifecycle para abortar multipart
// incompletos. `MEDIA_PUBLIC_BASE_URL` es ese dominio: en staging y production lo inyecta
// `scripts/deploy.mjs` desde las variables de GitHub Actions.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menusmax-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "menusmax-media-dev" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menusmax-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_PRIVATE", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
  ],
  // Limpieza diaria de rate_counters y email_domain_checks: 9:00 UTC = 3:00 en Ciudad de México.
  "triggers": { "crons": ["0 9 * * *"] },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "menusmax-jobs-dev" },
      { "binding": "JOBS_DLQ", "queue": "menusmax-jobs-dev-dlq" },
    ],
    "consumers": [
      {
        "queue": "menusmax-jobs-dev",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "menusmax-jobs-dev-dlq",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "menusmax-api-staging",
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "staging" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "menusmax-media-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "menusmax-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PUBLIC", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_PRIVATE", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } },
      ],
      // Limpieza diaria de rate_counters y email_domain_checks: 9:00 UTC = 3:00 en Ciudad de México.
      "triggers": { "crons": ["0 9 * * *"] },
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "menusmax-jobs-staging" },
          { "binding": "JOBS_DLQ", "queue": "menusmax-jobs-staging-dlq" },
        ],
        "consumers": [
          {
            "queue": "menusmax-jobs-staging",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "menusmax-jobs-staging-dlq",
          },
        ],
      },
    },
    "production": {
      "name": "menusmax-api",
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "production" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "menusmax-media" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "menusmax-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PUBLIC", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_PRIVATE", "namespace_id": "3003", "simple": { "limit": 300, "period": 60 } },
      ],
      // Limpieza diaria de rate_counters y email_domain_checks: 9:00 UTC = 3:00 en Ciudad de México.
      "triggers": { "crons": ["0 9 * * *"] },
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "menusmax-jobs" },
          { "binding": "JOBS_DLQ", "queue": "menusmax-jobs-dlq" },
        ],
        "consumers": [
          {
            "queue": "menusmax-jobs",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "menusmax-jobs-dlq",
          },
        ],
      },
    },
  },
}
