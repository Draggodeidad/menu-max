# Copia este archivo a .dev.vars para `pnpm --filter api dev`. Nunca commitees .dev.vars.
# ENVIRONMENT viene de `vars` en wrangler.jsonc; development habilita /docs y /openapi.json.

# Secreto compartido con apps/web para el header x-mm-internal (mínimo 32 caracteres).
INTERNAL_TOKEN=cambia-esto-por-un-valor-de-32-caracteres-o-mas

# Firma cookies y tokens. Usa un valor distinto de INTERNAL_TOKEN, de al menos 32 caracteres.
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:5173

# Remitente de los correos transaccionales (ADR-020). El subdominio lo da de alta un humano
# en Resend (SPF, DKIM y DMARC).
EMAIL_FROM="MenusMax <no-reply@mail.imanolantonio.dev>"

# API key de Resend. En development los correos solo se imprimen en la terminal de
# `wrangler dev` y nunca se llama a Resend, así que basta cualquier valor no vacío.
RESEND_API_KEY=cambia-esto-por-tu-api-key-de-resend

# Clave secreta de Turnstile (ADR-010). En development usa la clave de prueba de Cloudflare
# que siempre pasa; en staging y production, la del widget real (la configura un humano).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Dominio público del bucket R2 MEDIA (T17), sin diagonal final. En staging y production es el
# dominio propio conectado al bucket (nunca r2.dev); lo configura un humano. En development el
# bucket es local de wrangler y no tiene dominio público: las URLs solo sirven como referencia.
MEDIA_PUBLIC_BASE_URL=http://localhost:8787/media-local
