# Copia este archivo a .dev.vars para `pnpm --filter api dev`. Nunca commitees .dev.vars.
# ENVIRONMENT viene de `vars` en wrangler.jsonc; development habilita /docs y /openapi.json.

# Secreto compartido con apps/web para el header x-mm-internal (mínimo 32 caracteres).
INTERNAL_TOKEN=cambia-esto-por-un-valor-de-32-caracteres-o-mas

# Firma cookies y tokens de autenticación. Usa un valor distinto de INTERNAL_TOKEN.
BETTER_AUTH_SECRET=cambia-esto-por-otro-valor-de-32-caracteres-o-mas
WEB_ORIGIN=http://localhost:5173
