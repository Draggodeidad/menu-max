# Variables de ejemplo del monorepo. Nunca commitees valores reales.

# apps/api: Wrangler configura ENVIRONMENT; usa development para habilitar /docs y /openapi.json.

# Usa el mismo valor en apps/api/.dev.vars y apps/web/.dev.vars para x-mm-internal.
# Mínimo 32 caracteres. El binding API se configura en apps/web/wrangler.jsonc.
INTERNAL_TOKEN=cambia-esto-por-un-valor-de-32-caracteres-o-mas

# apps/api: usa un secreto distinto de INTERNAL_TOKEN (mínimo 32 caracteres).
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:5173

# apps/api: remitente de correos («Nombre <correo>»). El subdominio debe estar dado de alta
# en Resend (SPF, DKIM y DMARC).
EMAIL_FROM="MenusMax <no-reply@mail.imanolantonio.dev>"

# apps/api: API key de Resend (ADR-020). En development no se usa para enviar: basta
# cualquier valor no vacío.
RESEND_API_KEY=cambia-esto-por-tu-api-key-de-resend

# apps/api: clave secreta de Turnstile (ADR-010). En development, la clave de prueba de
# Cloudflare que siempre pasa; en staging y production, la del widget real.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# packages/database (drizzle-kit, driver d1-http). Solo para comandos remotos que
# ejecuta un humano o CI; `pnpm --filter database db:generate` no los necesita.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# El workflow de publicación lee CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_DATABASE_ID,
# WEB_ORIGIN y EMAIL_FROM desde las variables del entorno de GitHub Actions.
# Configura CLOUDFLARE_API_TOKEN, BETTER_AUTH_SECRET, INTERNAL_TOKEN, RESEND_API_KEY y
# TURNSTILE_SECRET_KEY como secretos de ese mismo entorno. El token de CI se configura en
# GitHub Actions.
