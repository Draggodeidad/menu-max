# Variables de ejemplo del monorepo. Nunca commitees valores reales.

# apps/api: Wrangler configura ENVIRONMENT; usa development para habilitar /docs y /openapi.json.

# apps/api (en local va en apps/api/.dev.vars) y apps/web: secreto del header x-mm-internal.
# Mínimo 32 caracteres.
INTERNAL_TOKEN=cambia-esto-por-un-valor-de-32-caracteres-o-mas

# packages/database (drizzle-kit, driver d1-http). Solo para comandos remotos que
# ejecuta un humano o CI; `pnpm --filter database db:generate` no los necesita.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
