                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "callbackURL": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["email"],
                "additionalProperties": false
              }
            }
          }
