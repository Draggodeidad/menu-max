          },
          {
            "in": "query",
            "name": "callbackURL",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          }
        ]
      }
    },
    "/v1/auth/reset-password": {
      "post": {
        "operationId": "postV1AuthResetPassword",
        "summary": "Restablecer la contraseña",
        "tags": ["Autenticación"],
        "security": [
          {
            "InternalToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["newPassword"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña restablecida y sesiones revocadas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
